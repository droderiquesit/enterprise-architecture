# /etc/hello-worker/hello-worker.env - written by the application deployment (run command); mode 0640.
# No secrets are required in Azure: Service Bus and Table Storage use the VM's user-assigned managed identity.
DD_ENV=dev
DD_SERVICE=hello-worker
DD_VERSION=1.0.0
OTEL_SERVICE_NAME=hello-worker
OTEL_RESOURCE_ATTRIBUTES=team=hello,domain=notifications,tier=backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CREDENTIAL_MODE=managed_identity
MESSAGING_MODE=servicebus
SERVICEBUS_FQDN=example.servicebus.windows.net
SB_TOPIC=order-events
SB_SUBSCRIPTION=notifications
TABLE_MODE=table
TABLES_ENDPOINT=https://example.table.core.windows.net
TABLE_NAME=notifications
MAX_CONCURRENCY=8
FAULTS_ENABLED=false
