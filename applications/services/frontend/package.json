{
  "name": "hello-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Enterprise Hello browser app (React + Vite) with Datadog Browser RUM",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@datadog/browser-rum": "7.15.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
