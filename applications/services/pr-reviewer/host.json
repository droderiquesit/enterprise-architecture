{
  "version": "2.0",
  "telemetryMode": "OpenTelemetry",
  "logging": {
    "logLevel": { "default": "Information", "Host.Results": "Error", "Function": "Information", "Host.Aggregator": "Warning" }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.0.0, 5.0.0)"
  },
  "extensions": {
    "http": { "routePrefix": "api" },
    "queues": {
      "messageEncoding": "none",
      "batchSize": 1,
      "newBatchThreshold": 0,
      "maxDequeueCount": 5,
      "visibilityTimeout": "00:00:30",
      "maxPollingInterval": "00:00:10"
    }
  },
  "functionTimeout": "00:10:00"
}
