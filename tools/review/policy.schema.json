{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterprise-architecture/tools/review/policy.schema.json",
  "title": "Automated PR review policy (.review/policy.yaml)",
  "description": "Deterministic decision policy of the eh-pr-reviewer. Read from the PR TARGET branch (never from the PR source branch). See docs/guides/automated-pr-review.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "owners",
    "bot",
    "status",
    "classes",
    "decision"
  ],
  "$defs": {
    "glob": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "globs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/glob"
      }
    },
    "severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ]
    }
  },
  "properties": {
    "schema_version": {
      "const": 1
    },
    "owners": {
      "description": "Azure DevOps identities (unique name or id) allowed to change owner_protected paths. A change to them by anyone else is a definite violation (vote reject).",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "owner_protected": {
      "$ref": "#/$defs/globs"
    },
    "bot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "names"
      ],
      "properties": {
        "names": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Unique/display names of the reviewer identity; PRs authored by it are never approved."
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "genre",
        "name"
      ],
      "properties": {
        "genre": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,40}$"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,40}$"
        },
        "target_url": {
          "type": "string"
        }
      }
    },
    "classes": {
      "description": "Ordered change classes; the first class whose matcher matches a path wins.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,40}$"
          },
          "description": {
            "type": "string"
          },
          "globs": {
            "$ref": "#/$defs/globs"
          },
          "builtin": {
            "enum": [
              "docs",
              "tests"
            ]
          },
          "refine": {
            "enum": [
              "dependencies",
              "observability"
            ]
          },
          "never_approve": {
            "type": "boolean",
            "default": false
          },
          "protected": {
            "type": "boolean",
            "default": false,
            "description": "Branch policy must require a human reviewer group for these paths (emitted into the branch-policy fragment)."
          }
        },
        "anyOf": [
          {
            "required": [
              "globs"
            ]
          },
          {
            "required": [
              "builtin"
            ]
          }
        ]
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auto_approve_classes"
      ],
      "properties": {
        "auto_approve_classes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "require_build_green": {
          "type": "boolean",
          "default": true
        },
        "blocking_severities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/severity"
          },
          "default": [
            "critical",
            "high",
            "medium"
          ]
        },
        "wait_for_author_severities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/severity"
          },
          "default": [
            "critical",
            "high"
          ]
        },
        "never_approve_target_branches": {
          "$ref": "#/$defs/globs"
        },
        "human_required_vote": {
          "enum": [
            0,
            5
          ],
          "default": 0
        },
        "max_files_for_auto_approve": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 40
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_changed_lines": {
          "type": "integer",
          "minimum": 1,
          "default": 2000
        },
        "max_files": {
          "type": "integer",
          "minimum": 1,
          "default": 150
        },
        "max_file_bytes": {
          "type": "integer",
          "minimum": 1024,
          "default": 512000
        },
        "max_inline_threads": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200,
          "default": 30
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entropy_min_length": {
          "type": "integer",
          "minimum": 16,
          "default": 32
        },
        "entropy_threshold_base64": {
          "type": "number",
          "default": 4.3
        },
        "entropy_threshold_hex": {
          "type": "number",
          "default": 3.2
        },
        "fixture_paths": {
          "$ref": "#/$defs/globs"
        },
        "skip_paths": {
          "$ref": "#/$defs/globs"
        }
      }
    },
    "terraform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sensitive_resource_types": {
          "$ref": "#/$defs/globs"
        },
        "security_attributes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manifest_schema": {
          "type": "string"
        },
        "prod_envs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "threshold_paths": {
          "description": "Dotted manifest paths ([*] = any list index, * = any key) whose numeric changes are threshold tuning, each with a guardrail range.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "min",
              "max"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow_new_packages": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "model": {
          "type": "string",
          "pattern": "^claude-[a-z0-9-]+$",
          "default": "claude-opus-5-5"
        },
        "api_key_env": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,60}$",
          "default": "ANTHROPIC_API_KEY"
        },
        "effort": {
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "default": "medium"
        },
        "max_input_chars": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 400000,
          "default": 120000
        },
        "max_file_chars": {
          "type": "integer",
          "minimum": 500,
          "maximum": 100000,
          "default": 20000
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 32000,
          "default": 8000
        },
        "max_findings": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        },
        "timeout_seconds": {
          "type": "number",
          "minimum": 5,
          "maximum": 600,
          "default": 120
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "default": 2
        },
        "server_fallbacks": {
          "type": "boolean",
          "default": true
        },
        "exclude_globs": {
          "$ref": "#/$defs/globs"
        },
        "blocking_severities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/severity"
          },
          "default": [
            "critical",
            "high"
          ]
        },
        "provider": {
          "enum": [
            "copilot",
            "claude",
            "none"
          ],
          "default": "copilot",
          "description": "copilot = GitHub Copilot code review for Azure Repos (comments only, configured in Azure DevOps; gated via the `copilot` section); claude = tools/review/ai.py (also needs enabled: true and an API key)."
        }
      }
    },
    "copilot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Read Copilot's PR threads and gate auto-approval on them."
        },
        "reviewer_names": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Display/unique names of the Copilot reviewer identity (case-insensitive)."
        },
        "reviewer_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Azure DevOps identity ids of the Copilot reviewer once known (preferred over names)."
        },
        "required_before_auto_approve": {
          "type": "boolean",
          "default": true
        }
      }
    }
  }
}
