{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "environment.schema.json",
  "title": "Lab environment (environments/<env>/environment.yaml)",
  "description": "Globals and per-component settings of one lab environment. See ADR-0001 §6. Values are inputs, never secrets.",
  "type": "object",
  "required": ["environment", "profile", "secrets"],
  "additionalProperties": true,
  "properties": {
    "environment": {
      "type": "object",
      "required": ["name", "location", "subscription_id", "tenant_id", "name_prefix", "owner", "team", "cost_center", "expires_on"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9]{1,7}$"},
        "location": {"type": "string", "pattern": "^[a-z0-9]+$"},
        "subscription_id": {"$ref": "#/$defs/guid"},
        "tenant_id": {"$ref": "#/$defs/guid"},
        "name_prefix": {"type": "string", "pattern": "^[a-z][a-z0-9]{1,5}$"},
        "owner": {"type": "string", "minLength": 1},
        "team": {"type": "string", "minLength": 1},
        "cost_center": {"type": "string", "minLength": 1},
        "expires_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "tags": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "profile": {"enum": ["minimal", "enterprise", "full", "specialized", "observability-only", "custom"]},
    "custom_components": {
      "type": "array",
      "items": {"$ref": "#/$defs/componentId"},
      "uniqueItems": true
    },
    "datadog": {
      "type": "object",
      "properties": {
        "site": {"enum": ["datadoghq.com", "us3.datadoghq.com", "us5.datadoghq.com", "datadoghq.eu", "ap1.datadoghq.com", "ap2.datadoghq.com", "ddog-gov.com", "uk1.datadoghq.com"]},
        "api_key_secret_name": {"type": "string"},
        "app_key_secret_name": {"type": "string"},
        "telemetry_verification": {
          "description": "Journey checked by observability/tools/verify/telemetry_verify.py after smoke (tools/smoke/telemetry.py; defaults hello-bff, hello-orders-api, hello-catalog-api + hello-frontend). A failed journey marks the run's application deployments verification=failed (heal re-runs them).",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "journey_services": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "frontend_service": {"type": "string"},
            "max_wait_seconds": {"type": "integer", "minimum": 30, "maximum": 3600}
          }
        }
      },
      "not": {"anyOf": [{"required": ["api_key"]}, {"required": ["app_key"]}]}
    },
    "secrets": {
      "description": "Delinea DevOps Secrets Vault (ADR-0001 section 14). Identifiers only: tenant/auth provider names are not secrets.",
      "type": "object",
      "required": ["provider", "tenant", "auth_provider"],
      "additionalProperties": false,
      "properties": {
        "provider": {"const": "delinea-dsv"},
        "tenant": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
        "tld": {"enum": ["com", "eu", "com.au", "ca"], "default": "com"},
        "auth_provider": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
        "base_url": {"type": "string", "pattern": "^https?://[^/]+(:[0-9]+)?/v1$"}
      }
    },
    "network": {
      "type": "object",
      "properties": {
        "hub_address_space": {"$ref": "#/$defs/cidr"},
        "spoke_address_space": {"$ref": "#/$defs/cidr"}
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "monthly_amount": {"type": "number", "minimum": 0},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "contact_emails": {"type": "array", "items": {"type": "string", "pattern": "^[^@\\s]+@[^@\\s]+$"}}
      }
    },
    "self_healing": {
      "description": "Pipeline self-healing policy (pipelines/README.md 'Self-healing'). Never rendered into Terraform inputs, so changing it does not change any deploy fingerprint.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean", "description": "heal-mode runs select failed/partial/canceled components and failed verifications (false: heal runs select nothing)."},
        "heal_interval_hours": {"type": "integer", "minimum": 1, "maximum": 24, "description": "Documentation of the heal schedule; the cron itself lives in the entry pipeline (ADO schedules are compile-time)."},
        "max_consecutive_failures": {"type": "integer", "minimum": 1, "maximum": 10, "description": "Circuit breaker: quarantine a component after N consecutive failed runs (default 3)."},
        "drift_auto_remediate": {"type": "boolean", "description": "Allow drift runs to plan+apply additive-only drift of components with drift.auto_remediate (never destroy/replace). Default false."},
        "auto_rollback": {"type": "boolean", "description": "Roll back application deployments whose deploy/smoke failed (default true). Infrastructure is never auto-rolled back."},
        "notify": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "work_item": {"type": "boolean", "description": "Open an Azure Boards work item on quarantine / remediation refusal."},
            "work_item_type": {"type": "string"},
            "area_path": {"type": "string"},
            "datadog_event": {"type": "boolean", "description": "Send a Datadog event (key fetched from DSV)."}
          }
        }
      }
    },
    "components": {
      "description": "Per-component settings blocks, rendered as var.settings of that root.",
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/componentId"},
      "additionalProperties": {"type": "object"},
      "properties": {
        "foundation-pr-reviewer": {
          "description": "Automated PR reviewer (foundation/pr-reviewer var.settings). `ado` is the trusted webhook allowlist: organization, project, project id, repository ids, reviewer identity id.",
          "type": "object",
          "properties": {
            "ado": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "organization": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,49}$"},
                "project": {"type": "string", "minLength": 1},
                "project_id": {"type": "string", "pattern": "^[0-9a-fA-F-]{36}$"},
                "repository_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9a-fA-F-]{36}$"}},
                "account_ids": {"type": "array", "items": {"type": "string"}},
                "reviewer_id": {"type": "string"}
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"profile": {"const": "custom"}}},
      "then": {"required": ["custom_components"], "properties": {"custom_components": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "guid": {"type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"},
    "cidr": {"type": "string", "pattern": "^\\d{1,3}(\\.\\d{1,3}){3}/\\d{1,2}$"},
    "componentId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"}
  }
}
