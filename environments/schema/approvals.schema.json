{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "approvals.schema.json",
  "title": "Approved destructive changes (environments/<env>/approvals.yaml)",
  "description": "tools/validate/plan_policy.py fails a plan that deletes or replaces a protected resource type unless an unexpired entry here matches the component and resource address.",
  "type": "object",
  "required": ["allow_destroy"],
  "additionalProperties": false,
  "properties": {
    "allow_destroy": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["component", "addresses", "approved_by", "reason", "expires_on"],
        "additionalProperties": false,
        "properties": {
          "component": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
          "addresses": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "Exact resource addresses or glob patterns (module.x.azurerm_subnet.*)."},
          "approved_by": {"type": "string", "minLength": 3},
          "reason": {"type": "string", "minLength": 3},
          "expires_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
        }
      }
    }
  }
}
