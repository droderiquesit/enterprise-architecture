 {
  "id": 109,
  "name": "[prod] catalog error logs (formula)",
  "type": "query alert",
  "query": "formula(\"q1\").last(\"5m\") > 5",
  "tags": [
   "team:catalog"
  ],
  "message": "synthetic",
  "options": {
   "thresholds": {
    "critical": 5
   },
   "variables": [
    {
     "data_source": "logs",
     "name": "q1",
     "indexes": [
      "*"
     ],
     "compute": {
      "aggregation": "count"
     },
     "search": {
      "query": "service:catalog-api env:production status:error"
     },
     "group_by": [
      {
       "facet": "service",
       "limit": 10
      }
     ]
    }
   ]
  },
  "overall_state": "OK",
  "created": "2026-09-01T10:00:00+00:00"
 },
