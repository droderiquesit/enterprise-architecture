[
 {
  "id": 101,
  "name": "[prod] orders-api error rate",
  "type": "query alert",
  "query": "avg(last_10m):sum:trace.aspnet_core.request.errors{env:production,service:orders-api}.as_count() / sum:trace.aspnet_core.request.hits{env:production,service:orders-api}.as_count() > 0.05",
  "tags": [
   "team:orders",
   "owner:orders@contoso.example",
   "severity:sev2"
  ],
  "message": "synthetic",
  "options": {
   "thresholds": {
    "critical": 1
   }
  },
  "overall_state": "OK",
  "created": "2026-09-01T10:00:00+00:00"
 },
