{
  "hosting": "none",
  "datadog": {"site": "datadoghq.com", "env": "test"},
  "databases": {
    "catalog_pg": {"engine": "postgres", "deployment_type": "flexible_server", "host": "pg", "database": "catalog",
                   "password_ref": {"kind": "file", "name": "/etc/datadog-agent/secrets/pg-password"}},
    "adapter_mysql": {"engine": "mysql", "deployment_type": "flexible_server", "host": "mysql",
                      "password_ref": {"kind": "file", "name": "/etc/datadog-agent/secrets/mysql-password"}}
  }
}
