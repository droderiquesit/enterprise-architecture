{
  "architecture": "aca",
  "catalog": {
    "component_of": [
      "system:enterprise-hello"
    ],
    "enabled": true,
    "lifecycle": "production",
    "type": "custom"
  },
  "dashboards": {
    "enabled": true,
    "workflow_metric_prefix": null
  },
  "enabled": true,
  "endpoints": [],
  "env": "dev",
  "generated_from": {
    "layers": [
      "global-defaults",
      "platform/aca",
      "profiles/job",
      "manifest"
    ],
    "manifest": "dev/hello-jobs.yaml",
    "sha256": "8a7d5e265c87d375a9d2e751362b978be0b1a0c7b35f45e76a95b543f19853df"
  },
  "idle_behavior": {
    "expected_quiet_hours": null,
    "scale_to_zero": true
  },
  "metadata": {
    "application": "enterprise-hello",
    "contacts": [
      {
        "contact": "fulfillment@example.com",
        "name": "fulfillment mailbox",
        "type": "email"
      }
    ],
    "depends_on": [
      "service:hello-durable",
      "queue:batch-items"
    ],
    "description": "Seed / reconcile-trigger / batch-item jobs.",
    "display_name": "hello-jobs",
    "domain": "fulfillment",
    "languages": [
      "python"
    ],
    "owner": "fulfillment@example.com",
    "repository": "https://dev.azure.com/example-org/enterprise-hello/_git/enterprise-architecture",
    "runbook_url": "https://runbooks.example.com/enterprise-hello/hello-jobs",
    "team": "fulfillment",
    "tier": "low"
  },
  "monitors": {
    "job.errors": {
      "evaluation_delay": null,
      "key": "job.errors",
      "message": "{{#is_alert}}**WARNING**: The job logged errors in its last run.{{/is_alert}}\n{{#is_warning}}**WARNING**: The job logged errors in its last run.{{/is_warning}}\n{{#is_no_data}}**NO DATA**: the monitored signal stopped arriving. Check the telemetry pipeline canary first (a broken pipeline looks like silence).{{/is_no_data}}\n{{#is_recovery}}Recovered.{{/is_recovery}}\n\nService: `hello-jobs` | env: `dev` | team: `fulfillment` | owner: fulfillment@example.com | tier: low\n\nTroubleshooting:\n1. Open the job logs and the job's root span in APM.\n\nRunbook: https://runbooks.example.com/enterprise-hello/hello-jobs#job-errors",
      "name": "[dev] hello-jobs job logged errors",
      "new_group_delay": 60,
      "no_data_timeframe": null,
      "notify": {
        "alert": [
          "team-fulfillment"
        ],
        "warning": [
          "team-fulfillment"
        ]
      },
      "notify_no_data": false,
      "priority": 3,
      "query": "logs(\"service:hello-jobs env:dev status:error\").index(\"*\").rollup(\"count\").last(\"1h\") > 0",
      "renotify_interval": 0,
      "require_full_window": false,
      "resource_role": null,
      "runbook_url": "https://runbooks.example.com/enterprise-hello/hello-jobs#job-errors",
      "severity": "warning",
      "tags": [
        "application:enterprise-hello",
        "domain:fulfillment",
        "env:dev",
        "managed_by:observability-package",
        "monitor:job.errors",
        "service:hello-jobs",
        "severity:warning",
        "team:fulfillment",
        "tier:low"
      ],
      "thresholds": {
        "critical": 0
      },
      "type": "log alert"
    },
    "job.missed_run": {
      "evaluation_delay": null,
      "key": "job.missed_run",
      "message": "{{#is_alert}}**WARNING**: The job did not run (or its logs are not reaching Datadog) within the expected schedule window.{{/is_alert}}\n{{#is_warning}}**WARNING**: The job did not run (or its logs are not reaching Datadog) within the expected schedule window.{{/is_warning}}\n{{#is_no_data}}**NO DATA**: the monitored signal stopped arriving. Check the telemetry pipeline canary first (a broken pipeline looks like silence).{{/is_no_data}}\n{{#is_recovery}}Recovered.{{/is_recovery}}\n\nService: `hello-jobs` | env: `dev` | team: `fulfillment` | owner: fulfillment@example.com | tier: low\n\nTroubleshooting:\n1. az containerapp job execution list -n <job> -g <rg> -o table\n2. If executions succeeded, check the Fluent Bit sidecar of the job (telemetry pipeline dashboard).\n\nRunbook: https://runbooks.example.com/enterprise-hello/hello-jobs#job-missed",
      "name": "[dev] hello-jobs job produced no logs in 1h",
      "new_group_delay": 60,
      "no_data_timeframe": null,
      "notify": {
        "alert": [
          "team-fulfillment"
        ],
        "warning": [
          "team-fulfillment"
        ]
      },
      "notify_no_data": false,
      "priority": 3,
      "query": "logs(\"service:hello-jobs env:dev\").index(\"*\").rollup(\"count\").last(\"1h\") < 1",
      "renotify_interval": 0,
      "require_full_window": false,
      "resource_role": null,
      "runbook_url": "https://runbooks.example.com/enterprise-hello/hello-jobs#job-missed",
      "severity": "warning",
      "tags": [
        "application:enterprise-hello",
        "domain:fulfillment",
        "env:dev",
        "managed_by:observability-package",
        "monitor:job.missed_run",
        "service:hello-jobs",
        "severity:warning",
        "team:fulfillment",
        "tier:low"
      ],
      "thresholds": {
        "critical": 1
      },
      "type": "log alert"
    }
  },
  "notifications": {
    "critical": [
      "team-fulfillment",
      "oncall"
    ],
    "default": [
      "team-fulfillment"
    ],
    "warning": [
      "team-fulfillment"
    ]
  },
  "package_version": "1.0.0",
  "presence_ref": "deploy-jobs.jobs.seed.id",
  "resources": [],
  "runtime": "python",
  "schema": "rendered-service/v1",
  "service": "hello-jobs",
  "slos": [],
  "synthetics_defaults": {
    "min_failure_duration": 120,
    "min_location_failed": 1,
    "retry": {
      "count": 1,
      "interval": 300
    }
  },
  "tags": [
    "application:enterprise-hello",
    "domain:fulfillment",
    "env:dev",
    "managed_by:observability-package",
    "service:hello-jobs",
    "team:fulfillment",
    "tier:low"
  ],
  "telemetry": {
    "dbm": {
      "enabled": false
    },
    "logs": {
      "route": "sidecar"
    },
    "profile": "job",
    "rum": {
      "enabled": false
    },
    "traces": {
      "enabled": true,
      "sample_rate": 1.0,
      "server_operation": "http.server.request"
    }
  }
}
