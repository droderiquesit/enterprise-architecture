#!/usr/bin/env bash
# Enterprise Hello / portable Datadog package: host log + OTLP setup (idempotent; safe to re-run).
# Secrets come from Delinea DSV at run time with the host's user-assigned managed identity (IMDS) - nothing
# secret is rendered into this script, the run command / extension settings or Terraform state (ADR-0001 §14).
#  1. dsv-fetch (observability/images/dsv-fetch, stdlib Python) installed twice:
#       /opt/eh-dsv-fetch/dsv-fetch        root, 0500  - Fluent Bit ExecStartPre (env-yaml into tmpfs)
#       /opt/eh-dsv-fetch/agent/dsv-fetch  dd-agent, 0500 - Datadog Agent secret_backend_command (owner = Agent
#                                          user, no group/other rights, as the Agent requires)
#     non-secret DSV settings in /etc/eh-dsv/dsv.json (tenant/base URL/auth/identity client id).
#  2. Datadog Agent ${agent_version} (pinned) via the official install script in DD_INSTALL_ONLY mode, AFTER this
#     script wrote datadog.yaml with api_key: ENC[<dsv ref>] + secret_backend_command (the install script then
#     keeps the file and needs no DD_API_KEY). OTLP receiver on localhost; optional APM Single Step Instrumentation;
#     Agent log collection (-> Observability Pipelines Worker) when the fleet policy makes the Agent the collector.
#  3. Fluent Bit ${fb_version} (pinned), config in /etc/fluent-bit-eh, unit fluent-bit-eh.service whose
#     ExecStartPre writes /run/fluent-bit-eh/fluentbit-env.yaml (RuntimeDirectory, tmpfs, 0700 dir / 0400 file)
#     that the config includes for ${"$"}{DD_API_KEY}.
# setup revision: ${setup_revision} (bump modules/host-agents var.setup_revision to force a re-run)
set -euo pipefail
FB_VERSION='${fb_version}'
AGENT_VERSION='${agent_version}'
DD_SITE_VALUE='${site}'
API_KEY_REF='${api_key_ref}'
CONF_DIR=/etc/fluent-bit-eh
STATE_DIR=/var/lib/fluent-bit-eh
ENV_FILE=/etc/default/fluent-bit-eh
DSV_DIR=/opt/eh-dsv-fetch
DSV_CONF=/etc/eh-dsv/dsv.json
IDENTITY_CLIENT_ID='${identity_client_id}'
CONFIGURE_AGENT='${configure_agent}'
INSTALL_AGENT='${install_agent}'
# Runtime overrides for hosts whose identity / log paths are only known on the node (Azure Batch job
# preparation task: EH_IDENTITY_CLIENT_ID = pool identity, EH_LOG_PATHS under $AZ_BATCH_NODE_ROOT_DIR).
IDENTITY_CLIENT_ID="$${EH_IDENTITY_CLIENT_ID:-$IDENTITY_CLIENT_ID}"
log() { echo "[eh-host-setup] $*"; }

if [ -z "$IDENTITY_CLIENT_ID" ]; then log "no managed identity client id (hosts[*].identity_client_id / EH_IDENTITY_CLIENT_ID): DSV cannot be read"; exit 3; fi

# ------------------------------------------------------------------ Datadog Agent (pinned, no key on disk)
agent_installed() {
  local v=""
  if command -v dpkg-query >/dev/null 2>&1; then v=$(dpkg-query -W -f='$${Version}' datadog-agent 2>/dev/null || true); fi
  if [ -z "$v" ] && command -v rpm >/dev/null 2>&1; then v=$(rpm -q --qf '%%{VERSION}' datadog-agent 2>/dev/null || true); fi
  case "$v" in *"$AGENT_VERSION"*) return 0 ;; *) return 1 ;; esac
}
agent_cfg_changed=0
if [ "$INSTALL_AGENT" = "true" ]; then
  install -d -m 0755 /etc/datadog-agent
  tmp=$(mktemp)
  cat > "$tmp" <<DDYAML
# Managed by the portable Datadog package (modules/host-agents). The API key is a Delinea DSV reference resolved by
# the Agent's secret backend (dsv-fetch agent-backend) with this host's managed identity; no key is stored here.
api_key: ENC[$API_KEY_REF]
site: $DD_SITE_VALUE
secret_backend_command: $DSV_DIR/agent/dsv-fetch
secret_backend_arguments:
  - agent-backend
  - --config
  - $DSV_CONF
secret_backend_timeout: 30
DDYAML
  if ! cmp -s "$tmp" /etc/datadog-agent/datadog.yaml; then
    # replaces any previous datadog.yaml (e.g. one written by the Datadog VM extension with a literal key)
    install -m 0640 "$tmp" /etc/datadog-agent/datadog.yaml; agent_cfg_changed=1
  fi
  rm -f "$tmp"
  # APM Single Step Instrumentation (host injection of the pinned Datadog library majors) and Fleet Automation
  # remote upgrades are options of the same official installer (fleet policy apm.mode = datadog / agent.remote_updates)
  ssi_missing=0
  if [ "${apm_ssi}" = "true" ] && [ ! -d /opt/datadog-packages/datadog-apm-inject ]; then ssi_missing=1; fi
  if ! agent_installed || [ $ssi_missing -eq 1 ]; then
    curl -fsSL --retry 5 -o /tmp/eh-dd-install.sh https://install.datadoghq.com/scripts/install_script_agent7.sh
    extra=()
    if [ "${apm_ssi}" = "true" ]; then extra+=(DD_APM_INSTRUMENTATION_ENABLED=host DD_APM_INSTRUMENTATION_LIBRARIES='${ssi_libraries}'); fi
    if [ "${remote_updates}" = "true" ]; then extra+=(DD_REMOTE_UPDATES=true); fi
    env DD_INSTALL_ONLY=true DD_AGENT_MAJOR_VERSION=7 DD_AGENT_MINOR_VERSION="$${AGENT_VERSION#7.}" DD_SITE="$DD_SITE_VALUE" "$${extra[@]}" bash /tmp/eh-dd-install.sh
    rm -f /tmp/eh-dd-install.sh
    agent_cfg_changed=1
    log "datadog-agent $AGENT_VERSION installed (install-only; api_key is an ENC[] DSV reference; SSI=${apm_ssi})"
  fi
  if getent group dd-agent >/dev/null; then chown root:dd-agent /etc/datadog-agent/datadog.yaml; fi
fi

# ------------------------------------------------------------------ dsv-fetch (Delinea DSV reader)
PY=""
for c in /opt/datadog-agent/embedded/bin/python3 /usr/bin/python3 /usr/local/bin/python3; do
  if [ -x "$c" ] && "$c" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' 2>/dev/null; then PY=$c; break; fi
done
if [ -z "$PY" ]; then log "dsv-fetch needs Python >= 3.11 (Datadog Agent embedded python3 or the distribution's python3)"; exit 5; fi
stage_dsv=$(mktemp -d)
echo '${dsv_fetch_gz}' | base64 -d | gunzip > "$stage_dsv/dsv_fetch.py"
install -d -m 0755 "$DSV_DIR" "$DSV_DIR/agent" /etc/eh-dsv
"$PY" -I "$stage_dsv/dsv_fetch.py" install --dest "$DSV_DIR/dsv-fetch" --python "$PY"
if getent passwd dd-agent >/dev/null; then
  "$PY" -I "$stage_dsv/dsv_fetch.py" install --dest "$DSV_DIR/agent/dsv-fetch" --python "$PY" --owner dd-agent
fi
rm -rf "$stage_dsv"
EH_CLIENT_ID="$IDENTITY_CLIENT_ID" "$PY" -I - "$DSV_CONF" <<'PYEOF'
import json, os, sys
cfg = json.loads('${dsv_config_json}')
cfg["AZURE_CLIENT_ID"] = os.environ["EH_CLIENT_ID"]
data = json.dumps(cfg, indent=2, sort_keys=True) + "\n"
path = sys.argv[1]
try:
    old = open(path, encoding="utf-8").read()
except OSError:
    old = None
if old != data:
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write(data)
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)
PYEOF

if [ "$CONFIGURE_AGENT" = "true" ]; then
  changed=$agent_cfg_changed
  for unit in datadog-agent datadog-agent-trace; do
    d=/etc/systemd/system/$unit.service.d
    install -d -m 0755 "$d"
    tmp=$(mktemp)
    cat > "$tmp" <<'UNIT'
[Service]
Environment=DD_OTLP_CONFIG_RECEIVER_PROTOCOLS_GRPC_ENDPOINT=localhost:4317
Environment=DD_OTLP_CONFIG_RECEIVER_PROTOCOLS_HTTP_ENDPOINT=localhost:4318
Environment=DD_OTLP_CONFIG_LOGS_ENABLED=false
Environment=DD_LOGS_ENABLED=${agent_logs}
Environment=DD_PROCESS_CONFIG_PROCESS_COLLECTION_ENABLED=${process_collection}
Environment=DD_REMOTE_CONFIGURATION_ENABLED=${remote_configuration}
Environment=DD_APM_ENABLED=true
Environment="DD_TAGS=${agent_tags}"
%{ if op_logs_url != "" ~}
Environment=DD_OBSERVABILITY_PIPELINES_WORKER_LOGS_ENABLED=true
Environment=DD_OBSERVABILITY_PIPELINES_WORKER_LOGS_URL=${op_logs_url}
%{ endif ~}
UNIT
    if ! cmp -s "$tmp" "$d/eh-observability.conf"; then mv "$tmp" "$d/eh-observability.conf"; chmod 0644 "$d/eh-observability.conf"; changed=1; else rm -f "$tmp"; fi
  done
  # Agent log collection (fleet policy logs.node_collector = agent): tail the application log files
  logs_conf=/etc/datadog-agent/conf.d/eh-applogs.d/conf.yaml
  if [ "${agent_logs}" = "true" ]; then
    install -d -m 0755 /etc/datadog-agent/conf.d/eh-applogs.d
    tmp=$(mktemp)
    echo '${agent_logs_conf}' | base64 -d > "$tmp"
    if ! cmp -s "$tmp" "$logs_conf"; then install -m 0644 "$tmp" "$logs_conf"; changed=1; fi
    rm -f "$tmp"
    if getent group dd-agent >/dev/null; then chown root:dd-agent "$logs_conf"; fi
  elif [ -f "$logs_conf" ]; then
    rm -f "$logs_conf"; changed=1
  fi
  if systemctl list-unit-files datadog-agent.service >/dev/null 2>&1; then
    systemctl daemon-reload
    systemctl enable datadog-agent >/dev/null 2>&1 || true
    if [ $changed -eq 1 ] || ! systemctl is-active --quiet datadog-agent; then
      systemctl restart datadog-agent || log "datadog-agent restart failed (check: datadog-agent secret)"
      log "datadog-agent (re)configured (secret backend dsv-fetch, OTLP localhost:4317/4318, logs=${agent_logs})"
    fi
  fi
fi

if [ "${install_fluent_bit}" != "true" ]; then log "agent-only host (no application log files)"; exit 0; fi

# ------------------------------------------------------------------ Fluent Bit package (pinned)
installed=""
if command -v dpkg-query >/dev/null 2>&1; then installed=$(dpkg-query -W -f='$${Version}' fluent-bit 2>/dev/null || true); fi
if [ -z "$installed" ] && command -v rpm >/dev/null 2>&1; then installed=$(rpm -q --qf '%%{VERSION}' fluent-bit 2>/dev/null || true); fi
if [ "$installed" != "$FB_VERSION" ]; then
  . /etc/os-release
  case "$ID" in
    ubuntu|debian)
      install -d -m 0755 /usr/share/keyrings
      curl -fsSL --retry 5 https://packages.fluentbit.io/fluentbit.key | gpg --dearmor --yes -o /usr/share/keyrings/fluentbit-keyring.gpg
      echo "deb [signed-by=/usr/share/keyrings/fluentbit-keyring.gpg] https://packages.fluentbit.io/$ID/$VERSION_CODENAME $VERSION_CODENAME main" > /etc/apt/sources.list.d/fluent-bit.list
      apt-get update -y -q
      apt-mark unhold fluent-bit >/dev/null 2>&1 || true
      DEBIAN_FRONTEND=noninteractive apt-get install -y -q --allow-downgrades "fluent-bit=$FB_VERSION"
      apt-mark hold fluent-bit
      ;;
    rhel|centos|rocky|almalinux|ol|azurelinux|mariner)
      rpm --import https://packages.fluentbit.io/fluentbit.key
      major=$${VERSION_ID%%.*}
      printf '[fluent-bit]\nname=Fluent Bit\nbaseurl=https://packages.fluentbit.io/centos/%s/\ngpgcheck=1\ngpgkey=https://packages.fluentbit.io/fluentbit.key\nenabled=1\n' "$major" > /etc/yum.repos.d/fluent-bit.repo
      (command -v dnf >/dev/null && dnf install -y "fluent-bit-$FB_VERSION") || yum install -y "fluent-bit-$FB_VERSION"
      ;;
    *) log "unsupported distribution $ID"; exit 2 ;;
  esac
  log "fluent-bit $FB_VERSION installed"
fi
systemctl disable --now fluent-bit.service >/dev/null 2>&1 || true

# ------------------------------------------------------------------ config (staged, dry-run, then swapped)
SECRETS_FILE='${secrets_file}'
stage=$(mktemp -d)
install -d -m 0755 "$stage/lua"
%{ for path, gz in files ~}
echo '${gz}' | base64 -d | gunzip > "$stage/${path}"
%{ endfor ~}
umask 077
# non-secret env only: the API key is written at service start by ExecStartPre into $SECRETS_FILE
cat > "$stage/env" <<ENVEOF
%{ for k, v in env ~}
${k}=${v}
%{ endfor ~}
ENVEOF
if [ -n "$${EH_LOG_PATHS:-}" ]; then sed -i "s|^FLB_LOG_PATHS=.*|FLB_LOG_PATHS=$EH_LOG_PATHS|" "$stage/env"; fi
install -d -m 0750 "$STATE_DIR"
# dry-run against a placeholder env file (the real one exists only while the service runs); the dry config sits in
# the staging dir so relative includes (parsers.yaml, lua/) resolve the same way
dry=$(mktemp -d)
printf 'env:\n  DD_API_KEY: dry-run-placeholder\n' > "$dry/fluentbit-env.yaml"
sed "s|$SECRETS_FILE|$dry/fluentbit-env.yaml|" "$stage/fluent-bit.yaml" > "$stage/.dry-run.yaml"
(set -a; . "$stage/env"; set +a; cd "$stage" && /opt/fluent-bit/bin/fluent-bit -c "$stage/.dry-run.yaml" --dry-run >/dev/null) || { log "fluent-bit dry-run failed; keeping previous config"; rm -rf "$stage" "$dry"; exit 4; }
rm -rf "$dry" "$stage/.dry-run.yaml"

restart=0
if ! cmp -s "$stage/env" "$ENV_FILE"; then install -m 0600 "$stage/env" "$ENV_FILE"; restart=1; fi
rm -f "$stage/env"
if [ ! -d "$CONF_DIR" ] || ! diff -qr "$stage" "$CONF_DIR" >/dev/null 2>&1; then
  rm -rf "$CONF_DIR.old"; [ -d "$CONF_DIR" ] && mv "$CONF_DIR" "$CONF_DIR.old"
  mv "$stage" "$CONF_DIR"; chmod 0755 "$CONF_DIR"
  restart=1
else
  rm -rf "$stage"
fi
chmod -R go-w "$CONF_DIR"

unit=/etc/systemd/system/fluent-bit-eh.service
cat > "$unit.tmp" <<UNIT
[Unit]
Description=Fluent Bit (application logs -> Datadog, portable Datadog package)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/default/fluent-bit-eh
WorkingDirectory=/etc/fluent-bit-eh
# tmpfs /run/fluent-bit-eh (0700, removed on stop); dsv-fetch writes the Fluent Bit env-yaml (0400) from DSV
RuntimeDirectory=fluent-bit-eh
RuntimeDirectoryMode=0700
%{ if fb_needs_key ~}
ExecStartPre=$DSV_DIR/dsv-fetch init --config $DSV_CONF --out /run/fluent-bit-eh --format env-yaml --env-yaml-name fluentbit-env.yaml --map DD_API_KEY=$API_KEY_REF
%{ endif ~}
ExecStart=/opt/fluent-bit/bin/fluent-bit -c /etc/fluent-bit-eh/fluent-bit.yaml
Restart=always
RestartSec=10
LimitNOFILE=65536
MemoryMax=512M

[Install]
WantedBy=multi-user.target
UNIT
if ! cmp -s "$unit.tmp" "$unit"; then mv "$unit.tmp" "$unit"; systemctl daemon-reload; restart=1; else rm -f "$unit.tmp"; fi
systemctl enable fluent-bit-eh.service >/dev/null
if [ $restart -eq 1 ] || ! systemctl is-active --quiet fluent-bit-eh.service; then systemctl restart fluent-bit-eh.service; log "fluent-bit-eh (re)started"; else log "fluent-bit-eh unchanged"; fi
