{
  "architecture": "swa",
  "catalog": {
    "component_of": [],
    "enabled": true,
    "lifecycle": "production",
    "type": "web"
  },
  "dashboards": {
    "enabled": true,
    "workflow_metric_prefix": null
  },
  "enabled": true,
  "endpoints": [
    {
      "browser_journey": true,
      "browser_steps": [
        {
          "name": "Home renders",
          "type": "assertPageContains",
          "value": "Shop"
        }
      ],
      "health_path": "/",
      "name": "site",
      "required": true,
      "synthetic": {
        "enabled": true,
        "locations": [
          "aws:eu-central-1"
        ],
        "private_location": false,
        "tick_every": 300
      },
      "url": "https://www.example.com",
      "visibility": "public"
    }
  ],
  "env": "test",
  "generated_from": {
    "layers": [
      "global-defaults",
      "profiles/frontend",
      "manifest"
    ],
    "manifest": "manifests/storefront.yaml",
    "sha256": "425eba0f82a06310aeec6ae20b9f08bcf31c71af79bfed07d708f3416f7f15d7"
  },
  "idle_behavior": {
    "expected_quiet_hours": null,
    "scale_to_zero": true
  },
  "metadata": {
    "application": "unspecified",
    "contacts": [],
    "depends_on": [],
    "description": "",
    "display_name": "storefront",
    "domain": "unspecified",
    "languages": [],
    "owner": "shop@example.com",
    "repository": null,
    "runbook_url": "https://runbooks.example.com/storefront",
    "team": "shop",
    "tier": "high"
  },
  "monitors": {
    "rum.error_count": {
      "evaluation_delay": null,
      "key": "rum.error_count",
      "message": "{{#is_alert}}**WARNING**: Users hit JavaScript or network errors.{{/is_alert}}\n{{#is_warning}}**WARNING**: Users hit JavaScript or network errors.{{/is_warning}}\n{{#is_no_data}}**NO DATA**: the monitored signal stopped arriving. Check the telemetry pipeline canary first (a broken pipeline looks like silence).{{/is_no_data}}\n{{#is_recovery}}Recovered.{{/is_recovery}}\n\nService: `storefront` | env: `test` | team: `shop` | owner: shop@example.com | tier: high\n\nTroubleshooting:\n1. RUM -> Error Tracking for storefront; group by @error.source (network vs source).\n2. Network errors on API calls: open the linked backend trace (resource -> APM).\n3. CORS failures: check CORS_ALLOWED_ORIGINS on the BFF includes the frontend origin.\n\nRunbook: https://runbooks.example.com/storefront#rum-errors",
      "name": "[test] storefront browser errors above 25 in 15m",
      "new_group_delay": 60,
      "no_data_timeframe": null,
      "notify": {
        "alert": [
          "shop"
        ],
        "warning": [
          "shop"
        ]
      },
      "notify_no_data": false,
      "priority": 3,
      "query": "rum(\"@type:error service:storefront env:test\").rollup(\"count\").last(\"15m\") > 25",
      "renotify_interval": 0,
      "require_full_window": false,
      "resource_role": null,
      "runbook_url": "https://runbooks.example.com/storefront#rum-errors",
      "severity": "warning",
      "tags": [
        "application:unspecified",
        "domain:unspecified",
        "env:test",
        "managed_by:observability-package",
        "monitor:rum.error_count",
        "service:storefront",
        "severity:warning",
        "team:shop",
        "tier:high"
      ],
      "thresholds": {
        "critical": 25
      },
      "type": "rum alert"
    },
    "rum.lcp_p75": {
      "evaluation_delay": null,
      "key": "rum.lcp_p75",
      "message": "{{#is_alert}}**WARNING**: Page load performance (Largest Contentful Paint, nanoseconds) degraded.{{/is_alert}}\n{{#is_warning}}**WARNING**: Page load performance (Largest Contentful Paint, nanoseconds) degraded.{{/is_warning}}\n{{#is_no_data}}**NO DATA**: the monitored signal stopped arriving. Check the telemetry pipeline canary first (a broken pipeline looks like silence).{{/is_no_data}}\n{{#is_recovery}}Recovered.{{/is_recovery}}\n\nService: `storefront` | env: `test` | team: `shop` | owner: shop@example.com | tier: high\n\nTroubleshooting:\n1. RUM view performance: compare by @view.url_path and @geo.country.\n\nRunbook: https://runbooks.example.com/storefront#rum-performance",
      "name": "[test] storefront LCP p75 above 4s",
      "new_group_delay": 60,
      "no_data_timeframe": null,
      "notify": {
        "alert": [
          "shop"
        ],
        "warning": [
          "shop"
        ]
      },
      "notify_no_data": false,
      "priority": 4,
      "query": "rum(\"@type:view service:storefront env:test\").rollup(\"pc75\", \"@view.largest_contentful_paint\").last(\"30m\") > 4000000000",
      "renotify_interval": 0,
      "require_full_window": false,
      "resource_role": null,
      "runbook_url": "https://runbooks.example.com/storefront#rum-performance",
      "severity": "warning",
      "tags": [
        "application:unspecified",
        "domain:unspecified",
        "env:test",
        "managed_by:observability-package",
        "monitor:rum.lcp_p75",
        "service:storefront",
        "severity:warning",
        "team:shop",
        "tier:high"
      ],
      "thresholds": {
        "critical": 4000000000
      },
      "type": "rum alert"
    }
  },
  "notifications": {
    "critical": [
      "shop"
    ],
    "default": [
      "shop"
    ]
  },
  "package_version": "2.0.0",
  "presence_ref": null,
