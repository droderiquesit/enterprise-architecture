{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "platform-shared contract v1",
  "type": "object",
  "required": [
    "resource_group_name",
    "acr_id",
    "acr_login_server",
    "log_analytics_workspace_id"
  ],
  "properties": {
    "resource_group_name": {
      "type": "string"
    },
    "acr_id": {
      "type": "string",
      "pattern": "^/subscriptions/[^/]+/"
    },
    "acr_login_server": {
      "type": "string"
    },
    "log_analytics_workspace_id": {
      "type": "string",
      "pattern": "^/subscriptions/[^/]+/"
    },
    "log_analytics_customer_id": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "acr_name": {
      "type": "string"
    },
    "acr_sku": {
      "enum": [
        "Basic",
        "Standard",
        "Premium"
      ]
    },
    "acr_private": {
      "type": "boolean"
    },
    "acr_public_network_access": {
      "type": "boolean"
    },
    "acr_pull_identities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acr_push_identities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "log_analytics_name": {
      "type": "string"
    }
  },
  "description": "Shared container registry (Entra-only) and platform-feature Log Analytics workspace. No secrets."
}
