{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Instrumentation / telemetry transport contract v2 (also emitted by the portable package for existing environments). Secrets are Delinea DSV references (dsv://<path>#<element>), never values; v2 replaces the v1 Key Vault secret ids (ADR-0001 section 14).",
  "type": "object",
  "required": [
    "datadog_site",
    "otlp",
    "fluentbit",
    "env",
    "api_key_ref",
    "secrets"
  ],
  "properties": {
    "datadog_site": {
      "type": "string"
    },
    "otlp": {
      "type": "object",
      "required": [
        "grpc_endpoint",
        "http_endpoint"
      ],
      "properties": {
        "grpc_endpoint": {
          "type": "string"
        },
        "http_endpoint": {
          "type": "string"
        },
        "default_protocol": {
          "enum": [
            "grpc",
            "http/protobuf"
          ],
          "description": "protocol managed runtimes should use against the gateway"
        },
        "node_agent_grpc_port": {
          "type": "integer"
        },
        "node_agent_http_port": {
          "type": "integer"
        },
        "host_agent_grpc_endpoint": {
          "type": "string"
        },
        "gateway_distribution": {
          "enum": [
            "upstream",
            "ddot",
            "external"
          ]
        },
        "internal_only": {
          "const": true,
          "description": "receivers are never exposed publicly"
        },
        "logs_policy": {
          "enum": [
            "drop",
            "forward"
          ],
          "description": "what the OTel gateway does with OTLP logs (drop = accepted and discarded; application logs arrive via Fluent Bit only)"
        },
        "headers_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^dsv://[A-Za-z0-9._/-]+(#[A-Za-z0-9._-]+)?$",
          "description": "DSV reference whose value is the full OTEL_EXPORTER_OTLP_HEADERS string; null when the gateway does not require auth"
        }
      }
    },
    "fluentbit": {
      "type": "object",
      "required": [
        "forward_host",
        "forward_port"
      ],
      "properties": {
        "forward_host": {
          "type": "string"
        },
        "forward_port": {
          "type": "integer"
        },
        "sidecar_image": {
          "type": "string"
        },
        "sidecar_config": {
          "type": "string",
          "description": "fluent-bit YAML config for file-tail sidecars (no secrets; includes the dsv-fetch env-yaml file for DD_API_KEY)"
        },
        "sidecar_forward_config": {
          "type": [
            "string",
            "null"
          ],
          "description": "fluent-bit YAML for sidecars that ship to the aggregator (forward) instead of Datadog"
        },
        "sidecar_parsers": {
          "type": [
            "string",
            "null"
          ],
          "description": "parsers.yaml content mounted next to the sidecar config"
        },
        "sidecar_lua": {
          "type": [
            "string",
            "null"
          ],
          "description": "lua/enterprise_hello.lua content mounted next to the sidecar config"
        },
        "sidecar_mode": {
          "enum": [
            "datadog",
            "forward"
          ]
        },
        "logs_intake_host": {
          "type": "string"
        },
        "forward_tls": {
          "type": "boolean"
        },
        "metrics_port": {
          "type": "integer"
        },
        "aca_console_allow": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Container Apps/Jobs (exact names or prefix*) whose ContainerAppConsoleLogs the aggregator forwards; all other apps in the environment are dropped (sidecar-collected)"
        },
        "forward_shared_key_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^dsv://[A-Za-z0-9._/-]+(#[A-Za-z0-9._-]+)?$",
          "description": "DSV reference of the Fluent Bit forward shared key"
        }
      }
    },
    "event_hub": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "namespace_id": {
          "type": "string"
        },
        "authorization_rule_id": {
          "type": "string"
        },
        "app_logs_hub": {
          "type": "string"
        },
        "platform_logs_hub": {
          "type": "string"
        },
        "activity_logs_hub": {
          "type": "string",
          "description": "optional (1.1+): hub for control-plane logs (subscription Activity Log, Entra ID); equals platform_logs_hub when shared"
        },
        "kafka_endpoint": {
          "type": "string",
          "description": "<namespace>.servicebus.windows.net:9093"
        },
        "consumer_group": {
          "type": "string"
        },
        "location": {
          "type": "string",
          "description": "diagnostic settings must target an Event Hub in the same region as the source resource"
        }
      }
    },
    "env": {
      "type": "object",
      "description": "env var maps per runtime: common, dotnet, python, browser",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "collector_identity_principal_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "log_routes": {
      "type": "object",
      "description": "authoritative application-log route per architecture (README-transport.md)",
      "additionalProperties": {
        "enum": [
          "daemonset",
          "host",
          "sidecar",
          "eventhub",
          "none"
        ]
      }
    },
    "aggregator": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "hosting": {
          "enum": [
            "container_app",
            "none"
          ]
        },
        "resource_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "fqdn": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "gateway": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "hosting": {
          "enum": [
            "container_app",
            "none"
          ]
        },
        "resource_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "fqdn": {
          "type": [
            "string",
            "null"
          ]
        },
        "sampling": {
          "enum": [
            "probabilistic",
            "tail",
            "none"
          ]
        }
      }
    },
    "batch_log_setup": {
      "type": [
        "object",
        "null"
      ],
      "description": "Azure Batch node log setup published by observability (ADR-0001 section 13): gzip+base64 Linux installer (pinned Fluent Bit, linux-host config, API key read from DSV on the node with the pool identity via dsv-fetch). Run by the job's job preparation task (deploy-jobs) with the env vars named here. No secrets.",
      "required": [
        "script_gzip_base64",
        "script_sha256",
        "fluent_bit_version",
        "log_paths_template"
      ],
      "properties": {
        "script_gzip_base64": {
          "type": "string",
          "minLength": 1
        },
        "script_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "fluent_bit_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "log_paths_template": {
          "type": "string"
        },
        "identity_env": {
          "type": "string"
        },
        "log_paths_env": {
          "type": "string"
        },
        "run_elevated": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "api_key_ref": {
      "type": "string",
      "pattern": "^dsv://[A-Za-z0-9._/-]+(#[A-Za-z0-9._-]+)?$",
      "description": "DSV reference of the Datadog API key, e.g. dsv://eh/dev/datadog-api-key#value"
    },
    "secrets": {
      "type": "object",
      "description": "How workloads resolve dsv:// references at runtime (DSV runtime env contract; no credentials).",
      "required": [
        "provider",
        "base_url",
        "auth"
      ],
      "properties": {
        "provider": {
          "const": "delinea-dsv"
        },
        "tenant": {
          "type": [
            "string",
            "null"
          ]
        },
        "tld": {
          "type": [
            "string",
            "null"
          ]
        },
        "base_url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "auth": {
          "enum": [
            "azure",
            "client_credentials",
            "none"
          ],
          "description": "DSV_AUTH for workloads (azure = managed identity / workload identity)"
        },
        "fetch_image": {
          "type": [
            "string",
            "null"
          ],
          "description": "dsv-fetch helper image (init containers / refresher), digest-pinned"
        },
        "env_file": {
          "type": "string",
          "description": "path of the Fluent Bit env-yaml file written by dsv-fetch inside containers"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}