run "defaults" {
  command = plan

  assert {
    condition     = module.account.capabilities == ["EnableServerless"]
    error_message = "NoSQL account must be serverless by default."
  }
  assert {
    condition     = output.contract.account.local_auth_enabled == false && output.contract.auth_mode == "entra-rbac"
    error_message = "Local (key) auth must be disabled for NoSQL."
  }
  assert {
    condition     = output.contract.account.public_network_access_enabled == false && output.contract.private_endpoint.group_id == "Sql" && output.contract.private_endpoint.id != null
    error_message = "Public access disabled and Sql private endpoint created."
  }
  assert {
    condition     = azurerm_cosmosdb_sql_container.this["inventory/items"].partition_key_paths[0] == "/sku" && azurerm_cosmosdb_sql_container.this["adapter/records"].partition_key_paths[0] == "/id"
    error_message = "Partition keys: items=/sku, records=/id."
  }
  assert {
    condition     = length(azurerm_cosmosdb_sql_container.this["inventory/items"].autoscale_settings) == 0
    error_message = "Serverless containers must not set throughput."
  }
  assert {
    condition     = azurerm_cosmosdb_sql_role_assignment.this["inventory"].principal_id == "aaaaaaaa-0000-0000-0000-000000000002" && endswith(azurerm_cosmosdb_sql_role_assignment.this["inventory"].role_definition_id, "/sqlRoleDefinitions/00000000-0000-0000-0000-000000000002") && endswith(azurerm_cosmosdb_sql_role_assignment.this["inventory"].scope, "/dbs/inventory")
    error_message = "hello-inventory-api gets Built-in Data Contributor scoped to db inventory."
  }
  assert {
    condition     = output.contract.databases.inventory.owner_identity_name == "hello-inventory-api" && output.contract.databases.adapter.owner_identity_name == "hello-dbadapter"
    error_message = "Owners per architecture matrix."
  }
  assert {
    condition     = output.contract.dbm.supported == false
    error_message = "DBM unsupported for Cosmos DB."
  }
}

run "provisioned_autoscale_no_pe" {
  command = plan
  variables {
    settings = { capacity_mode = "provisioned", private_endpoint_enabled = false }
  }
  assert {
    condition     = length(module.account.capabilities) == 0 && azurerm_cosmosdb_sql_container.this["inventory/items"].autoscale_settings[0].max_throughput == 1000
    error_message = "Provisioned mode uses autoscale 1000 RU/s max."
  }
  assert {
    condition     = output.contract.private_endpoint.id == null
    error_message = "No PE when disabled."
  }
}
