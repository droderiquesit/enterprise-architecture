run "defaults" {
  command = plan

  variables {
    settings = {}
  }

  assert {
    condition     = azurerm_managed_redis.this.sku_name == "Balanced_B0" && azurerm_managed_redis.this.public_network_access == "Disabled"
    error_message = "Balanced_B0 with public access disabled."
  }
  assert {
    condition     = azurerm_managed_redis.this.default_database[0].access_keys_authentication_enabled == false && azurerm_managed_redis.this.default_database[0].client_protocol == "Encrypted"
    error_message = "Access keys disabled; TLS only."
  }
  assert {
    condition     = azurerm_managed_redis.this.default_database[0].eviction_policy == "AllKeysLRU" && azurerm_managed_redis.this.default_database[0].persistence_redis_database_backup_frequency == null && azurerm_managed_redis.this.default_database[0].persistence_append_only_file_backup_frequency == null
    error_message = "allkeys-lru, no persistence."
  }
  assert {
    condition     = toset(keys(azurerm_managed_redis_access_policy_assignment.this)) == toset(["hello-catalog-api", "hello-dbadapter"])
    error_message = "Entra access policy assignments for hello-catalog-api and hello-dbadapter."
  }
  assert {
    condition     = length(module.private_endpoint) == 1 && output.contract.private_endpoint.group_id == "redisEnterprise"
    error_message = "redisEnterprise private endpoint."
  }
}
